{
  "rewrites": [
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/((?!api|icons|assets|favicon|manifest|flutter_service_worker|version|index|canvaskit|.well-known|delete-account).+)/:articleId",
      "destination": "/api/share?username=$1&articleId=:articleId"
    },
    {
      "source": "/((?!api/|icons/|assets/|favicon.png|manifest.json|flutter_service_worker.js|version.json|index.html|delete-account|delete-account.html|canvaskit/|.well-known/).*)",
      "destination": "/index.html"
    }
  ]
}
